pkgname=justssh
pkgver=1.0.1
pkgrel=1
pkgdesc="Minimal SSH launcher for the terminal"
arch=('x86_64' 'aarch64')
url="https://github.com/luynrs/justssh"
license=('MIT')
makedepends=('go')
source=("$pkgname-$pkgver.tar.gz::https://github.com/luynrs/justssh/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('dfb92d659932a697922dea274d281af925b0e7d8e6a97beecf7e19617179e35f')

build() {
	cd "$pkgname-$pkgver"
	go build -o jssh ./cmd/jssh
}

package() {
	cd "$pkgname-$pkgver"
	install -Dm755 jssh "$pkgdir/usr/bin/jssh"
	install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
